{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
 "lint-staged": {
  "*.{js,jsx,ts,tsx}": [
    "prettier --write"
  ],
  "*.{json,md,css,html}": [
    "prettier --write"
  ]
} 
}
